# ═══════════════════════════════════════════════════════════════════════════════
# Backend Environment Variables — Visual Agent Teacher Platform
# ═══════════════════════════════════════════════════════════════════════════════
# Copy this file to .env and fill in your values.
# For Vercel, set these in the Vercel Dashboard → Project → Settings → Environment Variables.
# ═══════════════════════════════════════════════════════════════════════════════

# ── Required ──────────────────────────────────────────────────────────────────

# MongoDB connection string (Atlas SRV or direct)
# Get from: mongodb.com/atlas → Connect → Drivers → copy the srv string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ai_teacher

# Secret for signing JWT tokens (generate a random string: openssl rand -hex 32)
JWT_SECRET=change-this-to-a-random-secret-string

# Admin credentials — bootstrap creates this admin on first start
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=admin123
ADMIN_USERNAME=admin

# ── Server ────────────────────────────────────────────────────────────────────

PORT=8000
NODE_ENV=development

# For Vercel deployment, set this to true so Express trusts the Vercel proxy
TRUST_PROXY=true

# CORS origins (comma-separated)
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,https://your-frontend.vercel.app

# Public URL of this backend (used for generating absolute audio URLs)
# On Vercel this will be your deployment URL
BACKEND_PUBLIC_URL=http://localhost:8000

# ── AI Provider (Required for AI lesson generation) ───────────────────────────

# Which AI provider to use by default
# Options: blaze, blazeapi, openrouter, openai, gemini
ACTIVE_LLM=blaze

# BlazeAI (OpenAI-compatible — blazeai.boxu.dev)
BLAZE_API_KEY=
BLAZE_BASE_URL=https://blazeai.boxu.dev/api
BLAZE_MODEL=qwen3.6-plus
BLAZE_FAST_MODEL=z-ai/glm-5.1
BLAZE_DEEP_MODEL=qwen3.6-plus-thinking

# OpenRouter (alternative AI provider)
# OPENROUTER_API_KEY=
# OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# OpenAI (direct)
# OPENAI_API_KEY=

# Google Gemini
# GEMINI_API_KEY=

# FastAPI backend (for voice/code features)
# FASTAPI_BASE_URL=http://localhost:8001
# FASTAPI_API_KEY=

# ── Text-to-Speech (Required for narration audio) ─────────────────────────────

# Provider: speechify, elevenlabs, azure, or none (disables TTS)
TTS_PROVIDER=speechify

# Speechify
SPEECHIFY_API_KEY=
SPEECHIFY_VOICE_ID=henry
SPEECHIFY_MODEL=simba-english

# ElevenLabs (alternative)
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Azure Speech (alternative)
# AZURE_SPEECH_KEY=
# AZURE_SPEECH_REGION=eastus

# ── File Storage (Optional — for saving uploaded files) ─────────────────────────
# If not configured, files are served locally from the /public directory
# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_REGION=us-east-1
# STORAGE_BUCKET_NAME=ai-teacher-assets
# STORAGE_ENDPOINT_URL=
# STORAGE_PUBLIC_BASE_URL=

# ── Email (Optional — for notifications) ──────────────────────────────────────
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@yourdomain.com
# SMTP_SECURE=false
# SMTP_TEST_MODE=true

# ── Advanced AI Tuning (Optional) ────────────────────────────────────────────

# Disable AI planner entirely (uses templates only)
# DISABLE_AI_PLANNER=true

# Timeouts (ms)
# AI_TIMEOUT_MS=600000
# AI_COOLDOWN_MS=120000

# DeepSeek-specific limits
# DEEPSEEK_CONTEXT_TOKENS=1000000
# DEEPSEEK_MAX_INPUT_CHARS=3200000
# DEEPSEEK_ANALYSIS_TOKENS=128000
# DEEPSEEK_CONTENT_TOKENS=256000
# DEEPSEEK_ANALYSIS_TIMEOUT=900000
# DEEPSEEK_CONTENT_TIMEOUT=1800000
# DEEPSEEK_COOLDOWN_MS=30000
# DEEPSEEK_SECTION_CHARS=800000

# BlazeAPI-specific config
# BLAZEAPI_BASE_URL=https://api.blazeapi.org/paid/v1
# BLAZEAPI_API_KEY=
# BLAZEAPI_ANALYSIS_TOKENS=32000
# BLAZEAPI_CONTENT_TOKENS=64000

# ── Rate Limiting ─────────────────────────────────────────────────────────────
# General API rate limit (requests per 60s window)
# Rate limit is 300 by default
