# ── Application ───────────────────────────────────────────────────────────────
PORT=8000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# ── MongoDB Atlas ────────────────────────────────────────────────────────────
# Get this from: mongodb.com/atlas → Connect → Drivers → copy the srv string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ai_teacher

# ── AI Provider ────────────────────────────────────────────────────────────────
# BlazeAI (OpenAI-compatible — blazeai.boxu.dev)
ACTIVE_LLM=blaze
BLAZE_API_KEY=
BLAZE_BASE_URL=https://blazeai.boxu.dev/api
BLAZE_MODEL=qwen3.6-plus
BLAZE_FAST_MODEL=z-ai/glm-5.1
BLAZE_DEEP_MODEL=qwen3.6-plus-thinking
# Additional supported Blaze models:
# - grok-4.20-fast
# - qwen3.6-max-preview-thinking
# - moonshotai/kimi-k2.6

# ── TTS ────────────────────────────────────────────────────────────────────────
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# ── Storage (optional) ─────────────────────────────────────────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# S3_BUCKET=

# ── Misc ───────────────────────────────────────────────────────────────────────
# DISABLE_AI_PLANNER=true
# AI_TIMEOUT_MS=600000
# AI_COOLDOWN_MS=120000
