# ── Application ───────────────────────────────────────────────────────────────
PORT=8000
NODE_ENV=development
ALLOWED_ORIGINS=http://localhost:3000

# ── MongoDB Atlas ────────────────────────────────────────────────────────────
# Get this from: mongodb.com/atlas → Connect → Drivers → copy the srv string
MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ai_teacher

# ── AI Provider ────────────────────────────────────────────────────────────────
# Option 1: AgentRouter (OpenAI-compatible) — deepseek-v4-pro
# Token: https://agentrouter.org/console/token
# Note: AgentRouter blocks most server apps; BLAZE_API_KEY enables auto-fallback on upload.
ACTIVE_LLM=deepseek
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://agentrouter.org/v1
DEEPSEEK_MODEL=deepseek-v4-pro
# Optional: local forward proxy you run (see AgentRouter community guides)
# AGENTROUTER_PROXY_URL=http://localhost:8318/v1
# DeepSeek limits (optional — generous defaults for long documents)
# DEEPSEEK_CONTEXT_TOKENS=1000000
# DEEPSEEK_MAX_INPUT_CHARS=3200000
# DEEPSEEK_SECTION_CHARS=800000
# DEEPSEEK_ANALYSIS_TOKENS=128000
# DEEPSEEK_CONTENT_TOKENS=256000
# DEEPSEEK_ANALYSIS_TIMEOUT=900000
# DEEPSEEK_CONTENT_TIMEOUT=1800000

# Option 2: BlazeAI (free, OpenAI-compatible — blazeai.boxu.dev)
# ACTIVE_LLM=blaze
# BLAZE_API_KEY=
# BLAZE_BASE_URL=https://blazeai.boxu.dev/api
# BLAZE_MODEL=qwen3.6-plus
# BLAZE_FAST_MODEL=z-ai/glm-5.1
# BLAZE_DEEP_MODEL=qwen3.6-plus-thinking

# ── TTS ────────────────────────────────────────────────────────────────────────
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=

# ── Storage (optional) ─────────────────────────────────────────────────────────
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_REGION=
# S3_BUCKET=

# ── Misc ───────────────────────────────────────────────────────────────────────
# DISABLE_AI_PLANNER=true
# AI_TIMEOUT_MS=600000
# AI_COOLDOWN_MS=120000
