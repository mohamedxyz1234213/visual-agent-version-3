# Backend Environment Variables — Visual Agent Teacher Platform
# Copy to backend/.env for local dev, or set in Vercel Dashboard for production.
# Generate Vercel-ready values: npm run vercel:env

# ── Required ──────────────────────────────────────────────────────────────────

MONGODB_URI=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/ai_teacher

ADMIN_EMAIL=admin@example.com
ADMIN_USERNAME=admin
ADMIN_PASSWORD=choose-a-strong-password

# ── Server ────────────────────────────────────────────────────────────────────

PORT=8000
NODE_ENV=development
TRUST_PROXY=true
ALLOWED_ORIGINS=http://localhost:3000,http://localhost:3001,http://localhost:3002,https://code-buddy-student.vercel.app,https://YOUR-ADMIN.vercel.app,https://YOUR-TEACHER.vercel.app
BACKEND_PUBLIC_URL=https://backend-teaching.vercel.app
PUBLIC_BASE_URL=https://code-buddy-student.vercel.app

# ── AI Provider (at least one required) ───────────────────────────────────────

ACTIVE_LLM=openrouter

# OpenRouter (recommended)
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# BlazeAI (alternative)
# BLAZE_API_KEY=
# BLAZE_BASE_URL=https://blazeai.boxu.dev/api
# BLAZE_MODEL=qwen3.6-plus

# BlazeAPI gateway (alternative)
# BLAZEAPI_API_KEY=
# BLAZEAPI_BASE_URL=https://api.blazeapi.org/paid/v1

# OpenAI (direct)
# OPENAI_API_KEY=

# Google Gemini
# GEMINI_API_KEY=

# FastAPI service (voice/code features)
# FASTAPI_BASE_URL=https://your-fastapi.onrender.com
# FASTAPI_API_KEY=

# ── Text-to-Speech ────────────────────────────────────────────────────────────

TTS_PROVIDER=speechify
SPEECHIFY_API_KEY=
SPEECHIFY_VOICE_ID=henry
SPEECHIFY_MODEL=simba-english

# ElevenLabs (alternative)
# TTS_PROVIDER=elevenlabs
# ELEVENLABS_API_KEY=
# ELEVENLABS_VOICE_ID=21m00Tcm4TlvDq8ikWAM

# Disable TTS entirely
# TTS_PROVIDER=none

# ── File Storage (recommended for Vercel production) ──────────────────────────
# Without storage, audio files are ephemeral on Vercel serverless.

# STORAGE_ACCESS_KEY_ID=
# STORAGE_SECRET_ACCESS_KEY=
# STORAGE_REGION=us-east-1
# STORAGE_BUCKET_NAME=ai-teacher-assets
# STORAGE_ENDPOINT_URL=
# STORAGE_PUBLIC_BASE_URL=

# ── Email (optional) ──────────────────────────────────────────────────────────

# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=no-reply@yourdomain.com
# SMTP_SECURE=false
# SMTP_TEST_MODE=true

# ── Admin bootstrap ───────────────────────────────────────────────────────────

# ADMIN_PASSWORD_FORCE=true

# ── Advanced (optional) ───────────────────────────────────────────────────────

# DISABLE_AI_PLANNER=true
# AI_TIMEOUT_MS=600000
# AI_COOLDOWN_MS=120000
